generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  WAITING_FOR_VERIFY
  PAID
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OUTSIDE
  INSIDE
  CANCELLED
}

enum ScanAction {
  CHECK_IN
  CHECK_OUT
}

enum ScanResult {
  VALID
  ALREADY_CHECKED_IN
  INVALID_ACTION
  CANCELLED
  WRONG_EVENT
  UNPAID
  INVALID
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String       @map("password_hash")
  name          String
  role          Role         @default(ORGANIZER)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  events        Event[]      @relation("OrganizerEvents")
  verifiedSlips Payment[]    @relation("AdminVerifiedPayments")
  scans         TicketScan[] @relation("StaffScans")
  articles      Article[]    @relation("UserArticles")
  checkers      TicketChecker[] @relation("OrganizerCheckers")

  @@map("users")
}

model Event {
  id           String      @id @default(cuid())
  organizerId  String      @map("organizer_id")
  name         String
  description  String
  imageUrl     String      @map("image_url")
  venue        String
  eventDate    DateTime    @map("event_date")
  startTime    String      @map("start_time")
  ticketPrice  Decimal     @map("ticket_price")
  totalTickets Int         @map("total_tickets")
  category     String      @default("Concert")
  status       EventStatus @default(DRAFT)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  organizer    User        @relation("OrganizerEvents", fields: [organizerId], references: [id])
  orders       Order[]
  tickets      Ticket[]
  scans        TicketScan[] @relation("EventScans")
  articles     Article[]   @relation("ArticleToEvent")
  checkers     TicketChecker[] @relation("EventCheckers")

  @@index([status, eventDate])
  @@map("events")
}

model Order {
  id                  String         @id @default(cuid())
  eventId             String         @map("event_id")
  customerName        String         @map("customer_name")
  customerEmail       String         @map("customer_email")
  customerPhone       String         @map("customer_phone")
  quantity            Int
  totalAmount         Decimal        @map("total_amount")
  platformFeePercent  Decimal        @default(5.00) @map("platform_fee_percent")
  platformFeeAmount   Decimal        @map("platform_fee_amount")
  organizerRevenue    Decimal        @map("organizer_revenue")
  checkoutTokenHash   String         @unique @map("checkout_token_hash")
  viewTokenHash       String?        @unique @map("view_token_hash")
  status              OrderStatus    @default(PENDING_PAYMENT)
  expiresAt           DateTime       @map("expires_at")
  deliveryStatus      DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryArtifactKey String?        @map("delivery_artifact_key")
  deliveryLastAttempt DateTime?      @map("delivery_last_attempt")
  deliveryError       String?        @map("delivery_error")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  event               Event          @relation(fields: [eventId], references: [id])
  payments            Payment[]
  tickets             Ticket[]

  @@index([customerEmail])
  @@index([status])
  @@map("orders")
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String        @map("order_id")
  amount       Decimal
  slipUrl      String        @map("slip_url")
  slipHash     String        @unique @map("slip_hash")
  status       PaymentStatus @default(PENDING)
  verifiedById String?       @map("verified_by")
  rejectReason String?       @map("reject_reason")
  verifiedAt   DateTime?     @map("verified_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifier     User?         @relation("AdminVerifiedPayments", fields: [verifiedById], references: [id])

  @@index([slipHash])
  @@map("payments")
}

model Ticket {
  id           String       @id @default(cuid())
  eventId      String       @map("event_id")
  orderId      String       @map("order_id")
  ticketNumber String       @unique @map("ticket_number")
  qrTokenHash  String       @unique @map("qr_token_hash")
  qrArtifactKey String      @map("qr_artifact_key")
  status       TicketStatus @default(OUTSIDE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  event        Event        @relation(fields: [eventId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scans        TicketScan[]

  @@index([eventId, status])
  @@map("tickets")
}

model TicketScan {
  id          String         @id @default(cuid())
  eventId     String         @map("event_id")
  ticketId    String?        @map("ticket_id")
  staffId     String         @map("staff_id")
  checkerId   String?        @map("checker_id")
  checkerName String?        @map("checker_name")
  action      ScanAction
  result      ScanResult
  note        String?
  scannedAt   DateTime       @default(now()) @map("scanned_at")

  event       Event          @relation("EventScans", fields: [eventId], references: [id])
  ticket      Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staff       User           @relation("StaffScans", fields: [staffId], references: [id])
  checker     TicketChecker? @relation(fields: [checkerId], references: [id], onDelete: SetNull)

  @@index([eventId, scannedAt])
  @@index([ticketId, scannedAt])
  @@index([checkerId, scannedAt])
  @@map("ticket_scans")
}

model TicketChecker {
  id          String       @id @default(cuid())
  organizerId String       @map("organizer_id")
  eventId     String       @map("event_id")
  name        String
  gateNote    String?      @map("gate_note")
  tokenHash   String       @unique @map("token_hash")
  accessToken String       @map("access_token")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  organizer   User         @relation("OrganizerCheckers", fields: [organizerId], references: [id], onDelete: Cascade)
  event       Event        @relation("EventCheckers", fields: [eventId], references: [id], onDelete: Cascade)
  scans       TicketScan[]

  @@index([tokenHash])
  @@index([eventId, organizerId])
  @@map("ticket_checkers")
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  articles  Article[]

  @@map("article_categories")
}

model ArticleTag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")

  articles  Article[] @relation("ArticleToTag")

  @@map("article_tags")
}

model Article {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  content        String
  excerpt        String?
  coverImageUrl  String?         @map("cover_image_url")
  seoTitle       String?         @map("seo_title")
  seoDescription String?         @map("seo_description")
  ogImageUrl     String?         @map("og_image_url")
  status         ArticleStatus   @default(DRAFT)
  authorId       String          @map("author_id")
  categoryId     String          @map("category_id")
  publishedAt    DateTime?       @map("published_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  author         User            @relation("UserArticles", fields: [authorId], references: [id])
  category       ArticleCategory @relation(fields: [categoryId], references: [id])
  tags           ArticleTag[]    @relation("ArticleToTag")
  events         Event[]         @relation("ArticleToEvent")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("articles")
}

