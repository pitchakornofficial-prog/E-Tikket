# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
# SQLite database (Development Default)
DATABASE_URL="file:./dev.db"
# EC2 uses SQLite on a persistent path; the current schema provider is sqlite.
# DATABASE_URL="file:/opt/e-tikket/shared/app.db"

# ---------------------------------------------------------
# AUTHENTICATION & SECURITY
# ---------------------------------------------------------
# Generate a unique random value of at least 32 characters for staff sessions.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Seed accounts credentials
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Platform Admin"
SEED_ADMIN_PASSWORD="12345678"
SEED_ORGANIZER_EMAIL="organizer@example.com"
SEED_ORGANIZER_NAME="Event Organizer"
SEED_ORGANIZER_PASSWORD="12345678"

# ---------------------------------------------------------
# APPLICATION URL
# ---------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# EC2: APP_ORIGIN="https://e-ticket.phatysd.me"
# EC2: LOCAL_STORAGE_DIR="/opt/e-tikket/shared/artifacts"

# ---------------------------------------------------------
# PRODUCTION EMAIL CONFIGURATION (Resend หรือ SMTP)
# ---------------------------------------------------------
# ตัวเลือกที่ 1: Resend (แนะนำ - ง่ายและเสถียรที่สุด)
# สมัครรับ API Key ได้ฟรีที่ https://resend.com
# RESEND_API_KEY="re_123456789..."

# ตัวเลือกที่ 2: SMTP (เช่น Gmail, SendGrid, Amazon SES, Mailgun)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ที่อยู่อีเมลผู้ส่ง
EMAIL_FROM="TICKETBOX <noreply@etikket.com>"
