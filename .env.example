# Copy this file to .env and use a disposable PostgreSQL database for development.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/e_tikket?schema=public"

# Set strong local-only credentials before running `npx prisma db seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Platform Admin"
SEED_ADMIN_PASSWORD="replace-with-a-strong-local-password"
SEED_ORGANIZER_EMAIL="organizer@example.com"
SEED_ORGANIZER_NAME="Event Organizer"
SEED_ORGANIZER_PASSWORD="replace-with-a-different-strong-local-password"

# Generate a unique random value of at least 32 characters for staff sessions.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Cloudflare R2 Object Storage (S3-compatible) configuration placeholders
R2_ACCOUNT_ID="replace-with-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_BUCKET_NAME="e-tikket-artifacts"
# Optional custom endpoint (default: https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
R2_ENDPOINT="https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com"
